{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Article pipeline GOLD locale sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "locale",
    "source_file_sha256",
    "source_article_sha256",
    "title",
    "article_markdown",
    "rows_by_tag"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "locale": { "const": "ru" },
    "source_file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_article_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "article_markdown": { "type": "string", "minLength": 1 },
    "rows_by_tag": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^B[1-9][0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_text"],
        "properties": {
          "display_text": { "type": "string", "minLength": 1 },
          "type_name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
