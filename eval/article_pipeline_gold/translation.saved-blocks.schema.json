{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved GOLD structural edition locale overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locale", "source_file_sha256", "source_structural_sha256", "source_block_count", "source_version_id", "blocks_by_fingerprint"],
  "properties": {
    "schema_version": { "const": 1 },
    "locale": { "const": "ru" },
    "source_file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_structural_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_block_count": { "type": "integer", "minimum": 1 },
    "source_version_id": { "type": "string", "minLength": 1 },
    "blocks_by_fingerprint": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[0-9a-f]{64}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_text", "type_name"],
        "properties": {
          "display_text": { "type": "string", "minLength": 1 },
          "type_name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
