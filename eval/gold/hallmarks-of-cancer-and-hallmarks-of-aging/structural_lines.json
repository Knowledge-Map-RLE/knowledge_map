    {
      "instanceId": "00065966-a6a0-8f23-b575-3ccd8f5d4c09",
      "blockType": 7,
      "data": {
        "hypothesis": "Aging is caused by hyperfunctional signaling pathways (e.g., mTOR) that continue developmental programs, leading to age-related diseases; hallmarks of aging should be arranged hierarchically with age-related diseases as the key organismal hallmark.",
        "disproofExplanation": "If aging were caused by molecular damage accumulation, then reducing damage would extend lifespan, but interventions that reduce damage do not consistently extend lifespan; instead, inhibiting mTOR extends lifespan."
      },
      "order": 7,
      "author": null
    },
