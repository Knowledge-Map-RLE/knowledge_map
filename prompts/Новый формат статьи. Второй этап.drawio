            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-295" value="Болезнь Паркинсона — БП" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1740" y="200" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r5hXMGkeLYIKXQ5QMk3x-1" value="&amp;nbsp;Мы призываем наших коллег принять этот клеточно-ориентированный подход с целью улучшения коммуникации в междисциплинарных исследованиях, нацеленных на молекулярные события, модулирующие межклеточные сигнальные пути и возникающие клинические фенотипы, связанные с БП." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1888" y="3000" width="200" height="240" as="geometry" />
        </mxCell>
