        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#B266FF;exitX=0;exitY=0.25;exitDx=0;exitDy=0;" parent="1" source="7qZIqy6ZL3z2aXDZ3tAA-41" target="7qZIqy6ZL3z2aXDZ3tAA-39" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="2420" as="sourcePoint" />
            <mxPoint x="1210" y="2360" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1170" y="2450" />
              <mxPoint x="1170" y="2350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#B266FF;exitX=0;exitY=0.25;exitDx=0;exitDy=0;" parent="1" source="7qZIqy6ZL3z2aXDZ3tAA-42" target="7qZIqy6ZL3z2aXDZ3tAA-39" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="2460" as="sourcePoint" />
            <mxPoint x="1210" y="2360" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1160" y="2490" />
              <mxPoint x="1160" y="2350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-46" value="&lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;Исследуется&lt;/b&gt;&lt;/font&gt; сложность болезни Паркинсона." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="2560" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-47" value="&lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;Предглагается&lt;/b&gt;&lt;/font&gt; системный подход." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="2660" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-48" value="&lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;Организуется&lt;/font&gt;&lt;/b&gt; доступная информация вокруг клеточных признаков болезни Паркинсона." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="2760" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-50" value="⚠️ Оценочные суждения. Вода. Тафталогия. Карта Знаний и так использует системный подход. Так же не имеет смысла так как может использоваться любой подход, лишь бы решил задачу. И не важно вокруг чего организуется информация если нам всё равно нужна полная достоверная система и там уже будет видно вокруг чего и как. Также уже были упомянуты клеточные системы." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="800" y="2560" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-51" value="Клеточные признаки болезни Паркинсона." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="2840" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-52" value="Болезь Паркинсона &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;обладает&lt;/font&gt;&lt;/b&gt; клеточными признаками" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="2840" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-53" value="Это единственное полезное из данного предложения." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="800" y="2840" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-54" value="&lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;Призываются&lt;/font&gt;&lt;/b&gt; коллегам принять клеточно-ориентированный подход." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="2960" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-55" value="&lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;Улучшить&amp;nbsp;&lt;/b&gt;&lt;/font&gt;коммуникации в междисциплинарных исследованиях." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="3000" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-56" value="Исследования &lt;font style=&quot;font-weight: bold;&quot; color=&quot;#1976d2&quot;&gt;нацеливаются&lt;/font&gt;&amp;nbsp;на молекулярные события, &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;модулирующие&lt;/font&gt;&lt;/b&gt; межклеточные сигнальные пути." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="3120" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-57" value="Исследования &lt;font style=&quot;font-weight: bold;&quot; color=&quot;#1976d2&quot;&gt;нацеливаются&lt;/font&gt;&amp;nbsp;на &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;возникающие&lt;/font&gt;&lt;/b&gt; клинические фенотипы &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;связанные&lt;/font&gt;&lt;/b&gt; с болезнью Паркинсона." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="3200" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-58" value="⚠️ Оценочное суждение. Вода" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="800" y="2960" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-59" value="⚠️ Оценочное суждение. Вода" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="800" y="3000" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-60" value="Молекулярные события &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;смодулировали&lt;/font&gt;&lt;/b&gt; межклеточные сигнальные пути" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3120" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-62" value="Болезнь Паркинсона &lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;обладает&lt;/b&gt;&lt;/font&gt;&amp;nbsp;фенотипом" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3240" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-63" value="Статья&lt;br&gt;&lt;br&gt;&lt;div&gt;doi: 10.1111/febs.12335&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The hallmarks of Parkinson&#39;s disease&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="120" height="160" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-64" value="Идиопатическая болезнь Паркинсона (ИБП) является вторым наиболее распространенным нейродегенеративным заболеванием после болезни Альцгеймера и поражает популяции по всему миру." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="3400" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-65" value="Абстракт" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=30;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="200" y="40" width="1480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-66" value="Введение" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=30;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="200" y="4120" width="1480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-67" value="Клинический синдром ИБП характеризуется брадикинезией, тремором покоя, ригидностью и постуральной нестабильностью." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="3680" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-68" value="Брадикинезия считается основным признаком и необходимым условием для диагностики ИБП." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="3880" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-69" value="В дополнение к этим двигательным симптомам многие пациенты испытывают широкий спектр немоторных симптомов, которые иногда даже предшествуют типичному двигательному расстройству, такие как гипосмия, нарушения сна (т.е. расстройство поведения в фазе быстрого сна), депрессия, запоры и другие дизавтономные симптомы." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="4240" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-70" value="В частности, гипосмия и расстройство поведения в фазе быстрого сна часто начинаются до появления основных двигательных симптомов." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="4520" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-71" value="В этом обзоре мы обсуждаем болезнь Паркинсона в глобальном смысле этого термина (БП), включая ИБП и генетически или экологически индуцированные формы паркинсонизма." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="4800" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-72" value="Действительно, многие клеточные признаки обнаружены как при БП, так и при ИБП." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="5080" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-73" value="Считается, что двигательные симптомы БП возникают в первую очередь из-за потери дофаминергических (ДА) нейронов в чёрной субстанции (ЧС), хотя, по-видимому, затронуты и другие нейромедиаторные системы (т.е. глутаматергическая, холинергическая, триптаминергическая, норадренергическая, адренергическая, серотонинергическая и пептидергическая)." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="5360" width="200" height="280" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-74" value="Лечение БП в настоящее время является симптоматическим и по существу включает замещение дофамина или подавление патологических нейронных осцилляций посредством глубокой стимуляции мозга." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="5680" width="200" height="280" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-75" value="Идиопатическая болезнь Паркинсона (ИБП) &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;вторая&lt;/font&gt;&lt;/b&gt; по распространённости среди нейродегенеративных заболеваний после болезни Альцгеймера" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="3400" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-76" value="Идиопатическая болезнь Паркинсона (ИБП) &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;поражает&lt;/font&gt;&lt;/b&gt; популяции по всему миру." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="3560" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-77" value="Идиопатическая болезнь Паркинсона (ИБП) &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;поразила&lt;/font&gt;&lt;/b&gt; популяции по всему миру." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3560" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-78" value="Идиопатическая болезнь Паркинсона (ИБП) &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;вторая&lt;/font&gt;&lt;/b&gt; по распространённости среди нейродегенеративных заболеваний после болезни Альцгеймера" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3400" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-79" value="Идиопатическая болезнь Паркинсона (ИБП) &lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;это&lt;/b&gt;&lt;/font&gt;&amp;nbsp;нейродегенеративное заболевание" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3480" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-80" value="Альцгеймер &lt;b style=&quot;color: rgb(25, 118, 210);&quot;&gt;это&lt;/b&gt;&amp;nbsp;нейродегенеративное заболевание" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3520" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-81" value="Синдром идиопатической болезни Паркинсона (ИБП) &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;характеризуется&lt;/font&gt;&lt;/b&gt; брадикинезией, тремором покоя, ригидностью и постуральной нестабильностью." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="3680" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-82" value="Брадикинезия &lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;признак&lt;/b&gt;&lt;/font&gt; синдрома идиопатической болезни Паркинсона (ИБП)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3680" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-83" value="Тремор покоя &lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;признак&lt;/font&gt;&lt;/b&gt; синдрома идиопатической болезни Паркинсона (ИБП)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3720" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-84" value="Ригидность &lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;признак&lt;/b&gt;&lt;/font&gt; синдрома идиопатической болезни Паркинсона (ИБП)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3760" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-85" value="Постуральная нестабильность&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;признак&lt;/font&gt;&lt;/b&gt; синдрома идиопатической болезни Паркинсона (ИБП)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3800" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-86" value="Брадикинезия основной и необходимый признак для диагностики синдрома идиопатической болезни Паркинсона (ИБП)." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="3880" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-87" value="Брадикинезия основной и необходимый признак для диагностики синдрома идиопатической болезни Паркинсона (ИБП)." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3880" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#e1d5e7;strokeColor=#B266FF;strokeWidth=3;" parent="1" source="7qZIqy6ZL3z2aXDZ3tAA-88" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="4020" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-88" value="&lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;Выявлена&lt;/font&gt;&lt;/b&gt; брадикинезия" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1200" y="4000" width="120" height="40" as="geometry" />
        </mxCell>
