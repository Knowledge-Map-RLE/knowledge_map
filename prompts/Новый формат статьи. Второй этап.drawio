        <mxCell id="r5hXMGkeLYIKXQ5QMk3x-100" value="Связи которые станут межблоковыми — они определяют что сначала был Блок 3, затем Блок 4 и 5" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
