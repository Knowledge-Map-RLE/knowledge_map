<mxfile host="Electron" modified="2026-03-12T06:28:32.340Z" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.4.13 Chrome/124.0.6367.207 Electron/30.0.6 Safari/537.36" etag="-pczqLVVeVjjMSvuHach" version="24.4.13" type="device">
