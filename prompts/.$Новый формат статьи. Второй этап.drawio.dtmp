        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-29" value="Болезнь Паркинсона &lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;это&amp;nbsp;&lt;/b&gt;&lt;/font&gt;многофакторное заболевание" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="3880.02" y="301.25" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;strokeWidth=3;strokeColor=#B266FF;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="7qZIqy6ZL3z2aXDZ3tAA-29" target="7qZIqy6ZL3z2aXDZ3tAA-20" edge="1">
