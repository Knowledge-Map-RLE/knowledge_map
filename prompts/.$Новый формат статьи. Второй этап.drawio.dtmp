        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-26" value="Генетический фактор&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1976d2&quot;&gt;повлиял на&lt;/font&gt;&lt;/b&gt; болезнь Паркинсона" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
