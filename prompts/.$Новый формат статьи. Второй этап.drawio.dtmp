        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-295" value="Болезнь Паркинсона — БП" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
