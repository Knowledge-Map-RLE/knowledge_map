        <mxCell id="ulW0zxMnz42PZs7xUlWT-46" value="&lt;font color=&quot;#ff8000&quot;&gt;Болезнь Паркинсона&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: rgb(178, 102, 255);&quot;&gt;имеет&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;background-color: initial;&quot; color=&quot;#3399ff&quot;&gt;клеточные признаки&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;align=center;" parent="1" vertex="1">
