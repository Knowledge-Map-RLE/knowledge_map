    <mxGraphModel dx="869" dy="507" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-250" value="Блоки начала&lt;br&gt;создают блоки&lt;br&gt;конца" style="endArrow=classic;html=1;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="7qZIqy6ZL3z2aXDZ3tAA-238" target="7qZIqy6ZL3z2aXDZ3tAA-237" edge="1">
          <mxGeometry x="-0.0188" y="-4" width="50" height="50" relative="1" as="geometry">
            <mxPoint x="8210.96" y="313.25" as="sourcePoint" />
            <mxPoint x="7889.96" y="536.25" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-1" value="&amp;nbsp;Мы призываем наших коллег принять этот клеточно-ориентированный подход с целью улучшения коммуникации в междисциплинарных исследованиях, нацеленных на молекулярные события, модулирующие межклеточные сигнальные пути и возникающие клинические фенотипы, связанные с БП." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="1201.25" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-2" value="Дофамин &lt;font color=&quot;#b266ff&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;открыт&lt;/b&gt;&lt;/font&gt; как нейромедиатор в 1950-х годах.&lt;div&gt;Since the&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#b266ff&quot;&gt;discovery&lt;/font&gt;&lt;/b&gt;&amp;nbsp;of dopamine as a neurotransmitter in the 1950s.&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="720" y="120" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-3" value="Исследования болезни Паркинсона (БП) &lt;b style=&quot;font-size: 14px;&quot;&gt;&lt;font color=&quot;#b266ff&quot; style=&quot;font-size: 14px;&quot;&gt;сформировали&lt;/font&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#1976d2&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/b&gt;богатую и сложную базу знаний.&lt;div&gt;Parkinson’s disease (PD) research has&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#b266ff&quot;&gt;generated&lt;/font&gt;&lt;/b&gt;&amp;nbsp;a rich and complex body of knowledge.&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="720" y="160" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-4" value="&lt;font color=&quot;#b266ff&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;С момента&lt;/b&gt;&lt;/font&gt; открытия дофамина как нейромедиатора в 1950-х годах исследования болезни Паркинсона (БП) сформировали богатую и сложную базу знаний, &lt;font color=&quot;#b266ff&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;выявив&lt;/b&gt;&lt;/font&gt;, что БП является возрастным многофакторным заболеванием, на которое влияют как генетические, так и факторы окружающей среды." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="200" y="120" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-5" value="Огромная сложность заболевания усиливается нелинейным прогрессированием патогенеза между молекулярными, клеточными и органическими системами." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="320" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-6" value="В этом мини-обзоре мы исследуем сложность БП и предлагаем системный подход, организуя доступную информацию вокруг клеточных признаков заболевания." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="200" y="561.25" width="200" height="158.75" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-7" value="Предложения" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=30;" parent="1" vertex="1">
          <mxGeometry x="200" y="40" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-8" value="Тезисы. Утверждения" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="720" y="80" width="560" height="20" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-9" value="Болезнь Паркинсона (БП) &lt;b&gt;&lt;font color=&quot;#b266ff&quot;&gt;является&lt;/font&gt;&lt;/b&gt; возрастным многофакторным заболеванием.&lt;div&gt;Revealing Parkinson&#39;s disease (PD)&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#b266ff&quot;&gt;to be&lt;/font&gt;&lt;/b&gt;&amp;nbsp;an age-related multifactorial disease.&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="720" y="200" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-10" value="На болезнь Паркинсона (БП) &lt;b&gt;&lt;font color=&quot;#b266ff&quot;&gt;влияют&lt;/font&gt;&lt;/b&gt;&amp;nbsp;генетические и факторы окружающей среды.&lt;div&gt;Parkinson&#39;s disease (PD) is&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#b266ff&quot;&gt;influenced&lt;/font&gt;&lt;/b&gt;&amp;nbsp;by both genetic and environmental factors.&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="720" y="240" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-12" value="Комментарий к тезису" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1320" y="80" width="360" height="20" as="geometry" />
        </mxCell>
