        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-20" value="&lt;div&gt;&lt;b style=&quot;color: rgb(255, 215, 0); background-color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;⭐ Цель ⭐&amp;nbsp;&lt;/b&gt;&lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;Исследована&lt;/b&gt;&lt;/font&gt; болезнь Паркинсона" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
