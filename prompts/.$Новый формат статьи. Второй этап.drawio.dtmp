        </mxCell>
        <mxCell id="7qZIqy6ZL3z2aXDZ3tAA-39" value="Болезнь Паркинсона &lt;font color=&quot;#1976d2&quot;&gt;&lt;b&gt;усилена&lt;/b&gt;&lt;/font&gt;&amp;nbsp;нелинейным прогрессированием патогенеза." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;" parent="1" vertex="1">
