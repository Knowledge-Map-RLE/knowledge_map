# Скопируйте в billing/.env
BILLING_HOST=0.0.0.0
BILLING_PORT=50058
LOG_LEVEL=INFO

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=50057

# ЮKassa: shopId и секретный ключ (тестовые/боевые из кабинета https://yookassa.ru)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=http://localhost:5555/subscription

# Внутренний токен для сервис-ту-сервис вызовов (main API -> billing)
INTERNAL_TOKEN=

# Интервал фоновой сверки незавершённых платежей, сек (0 — выключить)
RECONCILIATION_INTERVAL_SECONDS=300
