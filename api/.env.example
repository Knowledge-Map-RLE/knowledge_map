# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# API Configuration
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Deployment environment: development | staging | production.
# Конфиг читается из `.env.<ENVIRONMENT>` (development/staging/production),
# затем `.env.local`, затем `.env`. Для разработки: .env.development
# (LLM Extraction на локальной GGUF, UI-чат на cloud.ru).
ENVIRONMENT=development

# Единая директория логов api-сервиса.
LOG_DIR=logs

# Модель для UI-чата (всегда cloud.ru; переключение DEFAULT_PROVIDER в ai не влияет).
# Пусто — шлюз ai использует свой DEFAULT_PROVIDER.
AI_UI_MODEL=deepseek-ai/DeepSeek-V4-Flash

# LLM Extraction: модель для извлечения триплетов / цикла улучшения промпта.
# В development — локальная GGUF: local-gguf/Qwen3.8-4B-Distill-GGUF.
LLM_EXTRACT_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_MAX_TOKENS=262144

# Тарифы AI-запросов (₽ за 1 токен) — читаются domain.rules.ai_pricing.
# Базовые тарифы cloud.ru без наценки: 18,53 ₽/1M вход, 37,08 ₽/1M выход.
CLOUDRU_BASE_INPUT_PRICE=0.00001853
CLOUDRU_BASE_OUTPUT_PRICE=0.00003708

# Billing service (межсервисные вызовы api -> billing)
BILLING_SERVICE_URL=http://localhost:50058
INTERNAL_TOKEN=
# === Observability ===
LOG_FORMAT=logfmt
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=api
OTEL_SERVICE_VERSION=0.1.0
OTEL_METRIC_EXPORT_INTERVAL=30000
