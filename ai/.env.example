# ── AI Agent microservice ────────────────────────────────────────────
# ⚠️ Окружения: конфиг читается из `.env.<ENVIRONMENT>` (процессная переменная
# ENVIRONMENT: development|staging|production), иначе из `.env`. Пример для dev:
#   cp .env.example .env.development   # и задайте ENVIRONMENT=development
# Для локальной разработки: см. .env.development (Yandex + local GGUF).
AI_HOST=0.0.0.0
AI_PORT=50059

# Deployment environment: development | staging | production.
ENVIRONMENT=development

# Default provider/model used when the client does not specify one.
DEFAULT_PROVIDER=yandex-ai
DEFAULT_MODEL=gpt://b1gulkghbtm74u59sakh/deepseek-v4-flash/latest

# LM Studio (local OpenAI-compatible server). API key is ignored by LM Studio,
# but a non-empty value keeps the OpenAI SDK contract.
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio

# Yandex AI Studio / Yandex Cloud Foundation Models
YANDEX_CLOUD_FOLDER=b1gulkghbtm74u59sakh
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_MODEL=deepseek-v4-flash/latest

# Local GGUF model via llama-cpp-python (registered ONLY when ENVIRONMENT=development):
# скачивается с HuggingFace Hub при первом обращении в MODEL_CACHE_DIR.
HF_MODEL_REPO=empero-ai/Qwen3.8-4B-Distill-GGUF
HF_GGUF_FILE=Qwen3.8-4B-Q4_K_M.gguf
HUGGING_FACE_TOKEN=
MODEL_CACHE_DIR=./models
LOCAL_CONTEXT_LENGTH=262144
LOCAL_N_GPU_LAYERS=0
LOCAL_STRIP_REASONING=true

# Optional persona prepended when the client sends no system message.
# SYSTEM_PROMPT=You are an AI research assistant for a scientific knowledge-map editor.

# Optional: full provider list as JSON. When set, it overrides the LM Studio
# defaults above. Add DeepSeek Pro / Flash entries when available:
#   AI_PROVIDERS=[
#     {"name":"lm-studio","base_url":"http://localhost:1234/v1","api_key":"lm-studio","models":["qwen/qwen3-4b"]},
#     {"name":"deepseek-pro","base_url":"https://api.deepseek.com/v1","api_key":"sk-...","models":["deepseek-chat"]},
#     {"name":"deepseek-flash","base_url":"https://api.deepseek.com/v1","api_key":"sk-...","models":["deepseek-flash"]}
#   ]
# AI_PROVIDERS=

AI_REQUEST_TIMEOUT=300
AI_CONNECT_TIMEOUT=15
AI_MODELS_CACHE_TTL=60
LOG_LEVEL=INFO
# === Observability ===
LOG_FORMAT=logfmt
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=ai
OTEL_SERVICE_VERSION=0.1.0
OTEL_METRIC_EXPORT_INTERVAL=30000
