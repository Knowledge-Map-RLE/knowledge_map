# Общее окружение (для docker compose интерполяции и локальных скриптов).
# ENVIRONMENT: development | staging | production — выбирает .env.<ENVIRONMENT>
# для каждого сервиса (не храните реальные секреты здесь в репозитории).
ENVIRONMENT=development
LOG_DIR=logs

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
HUGGING_FACE_TOKEN=hf_token

# Local GGUF-модель для ai-микросервиса (only ENVIRONMENT=development)
HF_MODEL_REPO=empero-ai/Qwen3.8-4B-Distill-GGUF
HF_GGUF_FILE=Qwen3.8-4B-Q4_K_M.gguf

# cloud.ru Foundation Models (для compose и ai/.env.<ENV>)
CLOUDRU_API_KEY=
CLOUDRU_MODEL=deepseek-ai/DeepSeek-V4-Flash

# UI-чат всегда идёт на cloud.ru (не зависит от DEFAULT_PROVIDER в ai)
AI_UI_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Модель LLM-экстракции (в development — локальная GGUF: local-gguf/Qwen3.8-4B-Distill-GGUF)
LLM_EXTRACT_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Тарифы AI-запросов (₽ за 1 токен, base тарифы cloud.ru без наценки)
CLOUDRU_BASE_INPUT_PRICE=0.00001853
CLOUDRU_BASE_OUTPUT_PRICE=0.00003708

# Billing (ЮKassa): https://yookassa.ru -> Настройки -> API ключи
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5555/subscription

# Общий токен для сервис-ту-сервис вызовов (main API -> billing, auth и т.д.)
INTERNAL_TOKEN=

# === Citation Graph Sources ===
# OpenCitations (получить бесплатный токен: https://opencitations.net/accesstoken)
OPENCITATIONS_ACCESS_TOKEN=
OPENCITATIONS_EMAIL=

# OpenAlex (получить бесплатный ключ: https://openalex.org/settings/api)
OPENALEX_API_KEY=

# Crossref polite pool (email для User-Agent)
CROSSREF_MAILTO=

# DataCite (email для идентификации запросов)
DATACITE_EMAIL=